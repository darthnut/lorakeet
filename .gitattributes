# Files that run on Linux stations must keep LF line endings, whatever the checkout platform does.
*.sh text eol=lf
*.service text eol=lf
deploy/*.toml text eol=lf
*.timer text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.conf text eol=lf

# Left out of the release download (tools/build_release.py) and GitHub's "Source code" zips: what only developers
# use. A git clone still has everything.
tests/ export-ignore
.github/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.coveragerc export-ignore
pytest.ini export-ignore
ruff.toml export-ignore
requirements-dev.txt export-ignore
CLAUDE.md export-ignore
CONTRIBUTING.md export-ignore
CODE_OF_CONDUCT.md export-ignore
tools/build_release.py export-ignore
tools/release_check.py export-ignore
tools/api_docs.py export-ignore
tools/screenshots.mjs export-ignore
